{
  "package": {
    "description": "A responsive Ness.js dashboard with a NestJS metrics API.",
    "scripts": {
      "format": "prettier --write . --ignore-unknown",
      "format:check": "prettier --check . --ignore-unknown"
    },
    "devDependencies": {
      "prettier": "^3.9.6"
    },
    "prettier": {
      "singleQuote": true,
      "arrowParens": "avoid",
      "trailingComma": "all"
    }
  }
}
