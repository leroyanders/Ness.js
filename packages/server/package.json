{
  "name": "@nessframework/server",
  "version": "7.6.2",
  "description": "Request handling, middleware, routing rules, and web responses for Ness.js.",
  "homepage": "https://nessjs.com/docs/documentation/server/render",
  "bugs": {
    "url": "https://github.com/leroyanders/Ness.js/issues"
  },
  "keywords": [
    "ness",
    "nessjs",
    "server",
    "middleware",
    "http",
    "web-api",
    "request",
    "response",
    "cookies",
    "compression",
    "brotli",
    "redirects",
    "trust-proxy"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leroyanders/Ness.js.git",
    "directory": "packages/server"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./compress": {
      "types": "./src/compress.d.ts",
      "default": "./src/compress.js"
    },
    "./proxy": {
      "types": "./src/proxy.d.ts",
      "default": "./src/proxy.js"
    },
    "./runtime": {
      "types": "./src/runtime.d.ts",
      "default": "./src/runtime.js"
    },
    "./responses": {
      "types": "./src/responses.d.ts",
      "default": "./src/responses.js"
    },
    "./web-api": {
      "types": "./src/web-api.d.ts",
      "default": "./src/web-api.js"
    }
  },
  "files": [
    "src",
    "readme.md"
  ],
  "dependencies": {
    "@nessframework/cache": "^7.0.0",
    "@nessframework/instrumentation": "^7.0.0",
    "node-fetch": "^3.3.2",
    "react-router": "8.3.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "author": "Leroy Anders <leroy.anders23@gmail.com>",
  "license": "MIT"
}
