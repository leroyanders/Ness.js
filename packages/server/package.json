{
  "name": "@nessframework/server",
  "version": "8.3.0",
  "description": "Request handling, middleware, routing rules, and web responses for Ness.js.",
  "homepage": "https://nessjs.com/docs/documentation/server/render",
  "bugs": {
    "url": "https://github.com/leroyanders/Ness.js/issues"
  },
  "keywords": [
    "ness",
    "nessjs",
    "server",
    "middleware",
    "http",
    "web-api",
    "request",
    "response",
    "cookies",
    "compression",
    "brotli",
    "redirects",
    "trust-proxy"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leroyanders/Ness.js.git",
    "directory": "packages/server"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./compress": {
      "types": "./dist/compress.d.ts",
      "default": "./dist/compress.js"
    },
    "./proxy": {
      "types": "./dist/proxy.d.ts",
      "default": "./dist/proxy.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./responses": {
      "types": "./dist/responses.d.ts",
      "default": "./dist/responses.js"
    },
    "./web-api": {
      "types": "./dist/web-api.d.ts",
      "default": "./dist/web-api.js"
    },
    "./ppr": {
      "types": "./dist/ppr.d.ts",
      "default": "./dist/ppr.js"
    }
  },
  "files": [
    "!dist/.tsbuildinfo",
    "dist",
    "readme.md",
    "src"
  ],
  "dependencies": {
    "@nessframework/cache": "^8.0.0",
    "@nessframework/instrumentation": "^8.0.0",
    "node-fetch": "^3.3.2",
    "react-router": "8.3.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "author": "Leroy Anders <leroy.anders23@gmail.com>",
  "license": "MIT",
  "scripts": {
    "build": "tsc --build",
    "prepack": "tsc --build"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  }
}
