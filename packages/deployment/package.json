{
  "name": "@nessframework/deployment",
  "version": "7.3.0",
  "description": "Standalone output, dependency tracing, and Node, Lambda, and Cloudflare Workers adapters for Ness.js.",
  "keywords": [
    "ness",
    "nessjs",
    "deployment",
    "standalone",
    "bundle",
    "docker",
    "aws-lambda",
    "cloudflare-workers"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./standalone": {
      "types": "./src/standalone.d.ts",
      "default": "./src/standalone.js"
    },
    "./cloudflare": {
      "types": "./src/cloudflare.d.ts",
      "default": "./src/cloudflare.js"
    },
    "./lambda": {
      "types": "./src/lambda.d.ts",
      "default": "./src/lambda.js"
    },
    "./trace": {
      "types": "./src/trace.d.ts",
      "default": "./src/trace.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "readme.md"
  ],
  "dependencies": {
    "@remix-run/node-fetch-server": "0.13.3",
    "@nessframework/server": "^7.0.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "author": "Leroy Anders <leroy.anders23@gmail.com>",
  "license": "MIT"
}
