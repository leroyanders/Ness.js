{
  "name": "@nessframework/deployment",
  "version": "7.4.1",
  "description": "Standalone output, dependency tracing, and Node, Lambda, Cloudflare Workers, and Vercel adapters for Ness.js.",
  "homepage": "https://nessjs.com/docs/documentation/deployment",
  "bugs": {
    "url": "https://github.com/leroyanders/Ness.js/issues"
  },
  "keywords": [
    "ness",
    "nessjs",
    "deployment",
    "standalone",
    "bundle",
    "docker",
    "aws-lambda",
    "cloudflare-workers",
    "vercel",
    "serverless",
    "edge-runtime",
    "graceful-shutdown",
    "health-check",
    "wrangler",
    "express"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leroyanders/Ness.js.git",
    "directory": "packages/deployment"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./standalone": {
      "types": "./src/standalone.d.ts",
      "default": "./src/standalone.js"
    },
    "./cloudflare": {
      "types": "./src/cloudflare.d.ts",
      "default": "./src/cloudflare.js"
    },
    "./lambda": {
      "types": "./src/lambda.d.ts",
      "default": "./src/lambda.js"
    },
    "./vercel": {
      "types": "./src/vercel.d.ts",
      "default": "./src/vercel.js"
    },
    "./trace": {
      "types": "./src/trace.d.ts",
      "default": "./src/trace.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "readme.md"
  ],
  "dependencies": {
    "@remix-run/node-fetch-server": "0.13.3",
    "@nessframework/assets": "^7.0.0",
    "@nessframework/server": "^7.0.0",
    "express": "^5.2.1"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "author": "Leroy Anders <leroy.anders23@gmail.com>",
  "license": "MIT"
}
