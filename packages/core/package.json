    "react-dev-utils": "^12.0.1",
    "react-refresh": "^0.18.0",
    "react-router": "8.3.0",
    "react-server-dom-webpack": "19.2.8",
    "sade": "^1.8.1",
    "sass": "1.102.0",
    "sass-loader": "17.0.0",
    "sharp": "0.35.3",
    "source-map-support": "^0.5.21",
    "start-server-nestjs-webpack-plugin": "^2.2.5",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "tinyglobby": "^0.2.17",
    "typescript": "^7.0.2",
