    "@types/react-dom": "^19.2.4",
    "@types/webpack-env": "^1.18.8"
  },
  "keywords": [
    "nodejs",
    "express",
    "ssr",
    "ness",
    "react",
    "typescript",
    "react-router",
    "webpack"
  ]
