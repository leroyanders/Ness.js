{
  "name": "@nessframework/core",
  "description": "The framework core: Vite integration, configuration, and the server runtime for Ness.js.",
  "homepage": "https://nessjs.com/docs/documentation/packages",
  "bugs": {
    "url": "https://github.com/leroyanders/Ness.js/issues"
  },
  "keywords": [
    "ness",
    "nessjs",
    "framework",
    "full-stack",
    "react",
    "react-router",
    "nestjs",
    "vite",
    "ssr",
    "typescript",
    "server-side-rendering",
    "react-server-components",
    "express"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leroyanders/Ness.js.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "author": "Leroy Anders <leroy.anders23@gmail.com>",
  "version": "7.5.1",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json",
    "./cache": "./src/cache/index.js",
    "./client": "./src/runtime/client.js",
    "./config": {
      "types": "./src/framework/config.d.ts",
      "default": "./src/framework/config.js"
    },
    "./deployment": "./src/deployment/index.js",
    "./font": "./src/assets/font.js",
    "./image": {
      "browser": "./src/assets/image.js",
      "default": "./src/assets/image-server.js"
    },
    "./image/server": "./src/assets/image-server.js",
    "./instrumentation": "./src/instrumentation/index.js",
    "./metadata": "./src/metadata/index.js",
    "./rsc": "./src/rsc/index.js",
    "./script": "./src/assets/script.js",
    "./server": "./src/runtime/server.js",
    "./server/responses": "./src/runtime/responses.js",
    "./testing": "./src/testing/index.js",
    "./types/*": "./src/types/*",
    "./vite": {
      "types": "./src/vite/index.d.ts",
      "default": "./src/vite/index.js"
    }
  },
  "bin": {
    "ness-serve": "src/bin/serve.js"
  },
  "files": [
    "src",
    "readme.md"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "peerDependencies": {
    "react": ">=19.2.7",
    "react-dom": ">=19.2.7"
  },
  "dependencies": {
    "@nessframework/assets": "^7.0.0",
    "@nessframework/cache": "^7.0.0",
    "@nessframework/deployment": "^7.0.0",
    "@nessframework/instrumentation": "^7.0.0",
    "@nessframework/router": "^7.0.0",
    "@nessframework/server": "^7.0.0",
    "@nessframework/testing": "^7.0.0",
    "@remix-run/node-fetch-server": "0.13.3",
    "express": "^5.2.1",
    "mime-types": "^3.0.1",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4"
  }
}
