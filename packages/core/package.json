{
  "name": "@nessframework/core",
  "description": "The framework core: Vite integration, configuration, and the server runtime for Ness.js.",
  "homepage": "https://nessjs.com/docs/documentation/packages",
  "bugs": {
    "url": "https://github.com/leroyanders/Ness.js/issues"
  },
  "keywords": [
    "ness",
    "nessjs",
    "framework",
    "full-stack",
    "react",
    "react-router",
    "nestjs",
    "vite",
    "ssr",
    "typescript",
    "server-side-rendering",
    "react-server-components",
    "express"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leroyanders/Ness.js.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "author": "Leroy Anders <leroy.anders23@gmail.com>",
  "version": "9.4.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./cache": "./dist/cache/index.js",
    "./client": "./dist/runtime/client.js",
    "./config": {
      "types": "./dist/framework/config.d.ts",
      "default": "./dist/framework/config.js"
    },
    "./deployment": "./dist/deployment/index.js",
    "./font": "./dist/assets/font.js",
    "./image": {
      "browser": "./dist/assets/image.js",
      "default": "./dist/assets/image-server.js"
    },
    "./image/server": "./dist/assets/image-server.js",
    "./instrumentation": "./dist/instrumentation/index.js",
    "./metadata": "./dist/metadata/index.js",
    "./rsc": "./dist/rsc/index.js",
    "./script": "./dist/assets/script.js",
    "./server": "./dist/runtime/server.js",
    "./server/responses": "./dist/runtime/responses.js",
    "./testing": "./dist/testing/index.js",
    "./types/*": "./src/types/*",
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "default": "./dist/vite/index.js"
    },
    "./og": "./dist/assets/og.js"
  },
  "bin": {
    "ness-serve": "dist/bin/serve.js"
  },
  "files": [
    "!dist/.tsbuildinfo",
    "dist",
    "readme.md",
    "src"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "peerDependencies": {
    "react": ">=19.2.7",
    "react-dom": ">=19.2.7"
  },
  "dependencies": {
    "@nessframework/assets": "^8.1.0",
    "@nessframework/cache": "^8.0.0",
    "@nessframework/components": "^2.1.0",
    "@nessframework/deployment": "^8.1.0",
    "@nessframework/instrumentation": "^8.0.0",
    "@nessframework/router": "^9.2.0",
    "@nessframework/server": "^8.2.0",
    "@nessframework/testing": "^8.0.0",
    "@remix-run/node-fetch-server": "0.13.3",
    "express": "^5.2.1",
    "mime-types": "^3.0.1",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4"
  },
  "scripts": {
    "build": "tsc --build",
    "prepack": "tsc --build"
  }
}
