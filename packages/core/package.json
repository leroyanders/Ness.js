{
  "name": "@nessframework/core",
  "description": "Newest Experience of Server Side development. Awesome React framework ✨",
  "license": "MIT",
  "author": "Leroy Anders <leroy.anders23@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leroyanders/Ness.js.git",
    "directory": "packages/core"
  },
  "version": "6.0.0",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json",
    "./cache": "./src/cache/index.js",
    "./client": "./src/runtime/client.js",
    "./client/dom": "./src/client/dom.js",
    "./config": {
      "types": "./src/framework/config.d.ts",
      "default": "./src/framework/config.js"
    },
    "./deployment": "./src/deployment/index.js",
    "./font": "./src/assets/font.js",
    "./image": {
      "browser": "./src/assets/image.js",
      "default": "./src/assets/image-server.js"
    },
    "./image/server": "./src/assets/image-server.js",
    "./instrumentation": "./src/instrumentation/index.js",
    "./metadata": "./src/metadata/index.js",
    "./next/ui": "./src/next/ui.js",
    "./rsc": "./src/rsc/index.js",
    "./script": "./src/assets/script.js",
    "./server": "./src/runtime/server.js",
    "./server/responses": "./src/runtime/responses.js",
    "./server/dom": "./src/server/dom.js",
    "./testing": "./src/testing/index.js",
    "./types/*": "./src/types/*",
    "./vite": {
      "types": "./src/vite/index.d.ts",
      "default": "./src/vite/index.js"
    }
  },
  "bin": {
    "ness-core": "src/bin/index.js",
    "ness-serve": "src/bin/serve.js"
  },
  "files": [
    "src",
    "readme.md"
  ],
  "scripts": {
    "build": "babel src -d dist --extensions .js --copy-files"
  },
  "babel": {
    "presets": [
      "./src/babel/index.js"
    ]
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "peerDependencies": {
    "react": ">=19.2.7",
    "react-dom": ">=19.2.7"
  },
