{
  "name": "@nessframework/cache",
  "version": "7.0.0",
  "description": "Caching, stale-while-revalidate, tags, and path invalidation for Ness.js.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./resolve": {
      "types": "./src/resolve.d.ts",
      "default": "./src/resolve.js"
    },
    "./filesystem": {
      "types": "./src/adapters/filesystem.d.ts",
      "default": "./src/adapters/filesystem.js"
    },
    "./redis": {
      "types": "./src/adapters/redis.d.ts",
      "default": "./src/adapters/redis.js"
    },
    "./sqlite": {
      "types": "./src/adapters/sqlite.d.ts",
      "default": "./src/adapters/sqlite.js"
    },
    "./tiered": {
      "types": "./src/adapters/tiered.d.ts",
      "default": "./src/adapters/tiered.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "readme.md"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "author": "Leroy Anders <leroy.anders23@gmail.com>",
  "license": "MIT"
}
