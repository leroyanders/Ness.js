{
  "name": "@nessframework/cache",
  "version": "8.0.0",
  "description": "Caching, stale-while-revalidate, tags, and path invalidation for Ness.js.",
  "homepage": "https://nessjs.com/docs/documentation/caching",
  "bugs": {
    "url": "https://github.com/leroyanders/Ness.js/issues"
  },
  "keywords": [
    "ness",
    "nessjs",
    "cache",
    "isr",
    "stale-while-revalidate",
    "revalidation",
    "redis",
    "sqlite",
    "cache-invalidation",
    "memoize",
    "ttl",
    "distributed-cache",
    "request-deduplication"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leroyanders/Ness.js.git",
    "directory": "packages/cache"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./resolve": {
      "types": "./dist/resolve.d.ts",
      "default": "./dist/resolve.js"
    },
    "./filesystem": {
      "types": "./dist/adapters/filesystem.d.ts",
      "default": "./dist/adapters/filesystem.js"
    },
    "./redis": {
      "types": "./dist/adapters/redis.d.ts",
      "default": "./dist/adapters/redis.js"
    },
    "./sqlite": {
      "types": "./dist/adapters/sqlite.d.ts",
      "default": "./dist/adapters/sqlite.js"
    },
    "./tiered": {
      "types": "./dist/adapters/tiered.d.ts",
      "default": "./dist/adapters/tiered.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "!dist/.tsbuildinfo",
    "dist",
    "readme.md",
    "src"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "author": "Leroy Anders <leroy.anders23@gmail.com>",
  "license": "MIT",
  "scripts": {
    "build": "tsc --build",
    "prepack": "tsc --build"
  }
}
