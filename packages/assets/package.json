{
  "name": "@nessframework/assets",
  "version": "8.1.0",
  "description": "Images, fonts, scripts, and metadata for Ness.js applications.",
  "homepage": "https://nessjs.com/docs/documentation/assets",
  "bugs": {
    "url": "https://github.com/leroyanders/Ness.js/issues"
  },
  "keywords": [
    "ness",
    "nessjs",
    "react",
    "images",
    "image-optimization",
    "fonts",
    "metadata",
    "sitemap",
    "seo",
    "sharp",
    "webp",
    "avif",
    "open-graph",
    "robots-txt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leroyanders/Ness.js.git",
    "directory": "packages/assets"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./font": {
      "types": "./dist/font.d.ts",
      "default": "./dist/font.js"
    },
    "./image": {
      "types": "./dist/image.d.ts",
      "browser": "./dist/image.js",
      "default": "./dist/image-server.js"
    },
    "./image/server": {
      "types": "./dist/image-server.d.ts",
      "default": "./dist/image-server.js"
    },
    "./metadata": {
      "types": "./dist/metadata.d.ts",
      "default": "./dist/metadata.js"
    },
    "./script": {
      "types": "./dist/script.d.ts",
      "default": "./dist/script.js"
    },
    "./og": "./dist/image-response.js"
  },
  "files": [
    "!dist/.tsbuildinfo",
    "dist",
    "readme.md",
    "src"
  ],
  "dependencies": {
    "@nessframework/cache": "^8.0.0",
    "@nessframework/server": "^8.0.0",
    "sharp": "0.35.3"
  },
  "peerDependencies": {
    "react": ">=19.2.7",
    "satori": ">=0.10"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "author": "Leroy Anders <leroy.anders23@gmail.com>",
  "license": "MIT",
  "peerDependenciesMeta": {
    "satori": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc --build",
    "prepack": "tsc --build"
  }
}
