{
  "name": "@nessframework/assets",
  "version": "7.2.2",
  "description": "Images, fonts, scripts, and metadata for Ness.js applications.",
  "homepage": "https://nessjs.com/docs/documentation/assets",
  "bugs": {
    "url": "https://github.com/leroyanders/Ness.js/issues"
  },
  "keywords": [
    "ness",
    "nessjs",
    "react",
    "images",
    "image-optimization",
    "fonts",
    "metadata",
    "sitemap",
    "seo",
    "sharp",
    "webp",
    "avif",
    "open-graph",
    "robots-txt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leroyanders/Ness.js.git",
    "directory": "packages/assets"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./font": {
      "types": "./src/font.d.ts",
      "default": "./src/font.js"
    },
    "./image": {
      "types": "./src/image.d.ts",
      "browser": "./src/image.js",
      "default": "./src/image-server.js"
    },
    "./image/server": {
      "types": "./src/image-server.d.ts",
      "default": "./src/image-server.js"
    },
    "./metadata": {
      "types": "./src/metadata.d.ts",
      "default": "./src/metadata.js"
    },
    "./script": {
      "types": "./src/script.d.ts",
      "default": "./src/script.js"
    }
  },
  "files": [
    "src",
    "readme.md"
  ],
  "dependencies": {
    "@nessframework/cache": "^7.0.0",
    "@nessframework/server": "^7.0.0",
    "sharp": "0.35.3"
  },
  "peerDependencies": {
    "react": ">=19.2.7"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "author": "Leroy Anders <leroy.anders23@gmail.com>",
  "license": "MIT"
}
