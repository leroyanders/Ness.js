{
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "plugins/*",
    "templates/*",
    "examples/*",
    "docs"
  ],
  "version": "7.0.0",
  "description": "Newest Experience of Server Side development. Awesome React framework ✨",
  "directories": {
    "doc": "docs",
    "example": "examples"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "overrides": {
    "@jsonjoy.com/fs-node-builtins": "4.64.0",
    "serialize-javascript": "^7.0.5",
    "uuid": "^11.1.1"
  },
  "resolutions": {
    "@jsonjoy.com/fs-node-builtins": "4.64.0",
    "serialize-javascript": "^7.0.5",
    "uuid": "^11.1.1"
  },
  "scripts": {
    "build": "npm run build --workspace docs && npm run build --workspace welcome",
    "check": "npm run format:check && npm test && npm run build",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "test": "npm run test:unit && npm run test:types",
    "test:e2e": "node scripts/e2e/smoke.mjs",
    "release": "node scripts/release/publish.mjs",
    "test:unit": "node --test packages/*/test/*.test.js plugins/*/test/*.test.js",
    "test:types": "tsc --noEmit --skipLibCheck false --module NodeNext --moduleResolution NodeNext --target ES2022 --lib ES2022,DOM --types node,react --jsx react-jsx packages/core/test/types-smoke.ts plugins/types-smoke.ts",
    "publish:core": "npm publish --workspace @nessframework/core --access public",
    "publish:assets": "npm publish --workspace @nessframework/assets --access public",
    "publish:cache": "npm publish --workspace @nessframework/cache --access public",
    "publish:deployment": "npm publish --workspace @nessframework/deployment --access public",
    "publish:instrumentation": "npm publish --workspace @nessframework/instrumentation --access public",
    "publish:router": "npm publish --workspace @nessframework/router --access public",
    "publish:server": "npm publish --workspace @nessframework/server --access public",
    "publish:testing": "npm publish --workspace @nessframework/testing --access public",
    "publish:cli": "npm publish --workspace @nessframework/cli --access public",
    "publish:default": "npm publish --workspace @nessframework/default --access public",
    "publish:typescript": "npm publish --workspace @nessframework/typescript --access public",
    "publish:minimal": "npm publish --workspace @nessframework/minimal --access public",
    "publish:api": "npm publish --workspace @nessframework/api --access public",
    "publish:dashboard": "npm publish --workspace @nessframework/dashboard --access public",
    "publish:tailwind": "npm publish --workspace @nessframework/tailwind --access public",
    "publish:nest": "npm publish --workspace @nessframework/nest --access public",
    "publish:analyzer": "npm publish --workspace @nessframework/analyzer --access public",
    "publish:compression": "npm publish --workspace @nessframework/compression --access public",
    "publish:env": "npm publish --workspace @nessframework/env --access public",
    "publish:security": "npm publish --workspace @nessframework/security --access public",
    "publish:components": "npm publish --workspace @nessframework/components --access public"
  },
  "devDependencies": {
    "@vitejs/plugin-rsc": "0.5.27",
    "prettier": "^3.9.6",
    "react-router": "8.3.0",
    "react-server-dom-webpack": "19.2.8"
  },
  "author": "Leroy Anders <leroy.anders23@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@nessframework/core": "^8.1.0",
    "@nessframework/router": "^8.1.0",
    "@nessframework/server": "^7.6.2"
  }
}
