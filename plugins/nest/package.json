{
  "name": "@nessframework/nest",
  "version": "2.0.2",
  "description": "NestJS server routes for Ness.js applications",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./server": {
      "types": "./src/server.d.ts",
      "default": "./src/server.js"
    }
  },
  "files": [
    "src",
    "readme.md"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "peerDependencies": {
    "@nessframework/core": ">=7.0.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "express": "^5.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "vite": ">=5.0.0"
  },
  "dependencies": {
    "@nestjs/platform-express": "11.1.28",
    "fs-extra": "11.4.0",
    "tinyglobby": "0.2.17",
    "typescript": "5.7.3"
  },
  "license": "MIT"
}
